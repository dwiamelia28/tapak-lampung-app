rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.admin == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Profil: pemilik boleh baca/ubah, tetapi TIDAK boleh mengubah role.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.role == 'user';
      allow update: if isOwner(uid) && request.resource.data.role == resource.data.role
        && (!('photoBase64' in request.resource.data) || request.resource.data.photoBase64 == null
            || request.resource.data.photoBase64.size() < 120000);
      allow delete: if isAdmin();
    }

    // Token FCM per perangkat (mendukung banyak perangkat).
    match /users/{uid}/devices/{deviceId} {
      allow read, write: if isOwner(uid);
    }

    // Foto Base64 dibatasi ukurannya agar dokumen tetap di bawah batas 1 MiB.
    function photoOk(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || request.resource.data[field].size() < 300000;
    }

    // Jurnal Budaya: milik pengguna sendiri (CRUD).
    match /journal_entries/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && photoOk('imageBase64');
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid && photoOk('imageBase64');
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Rencana kunjungan: hanya pemiliknya.
    match /visit_plans/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && photoOk('photoBase64');
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid && photoOk('photoBase64');
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Daftar belajar: referensi pribadi ke topik materi.
    match /study_items/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Pengaturan pengingat belajar (satu dokumen per pengguna).
    match /reminder_settings/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Progres (paket Spark: dihitung di klien, bukan Cloud Functions).
    match /user_progress/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid);
    }

    // Konten: semua pengguna login boleh membaca, hanya admin yang menulis.
    match /{coll}/{docId} {
      allow read: if signedIn() &&
        coll in ['chapters', 'cultural_contents', 'quizzes', 'challenges', 'achievements', 'announcements'];
      allow write: if isAdmin() &&
        coll in ['chapters', 'cultural_contents', 'quizzes', 'challenges', 'achievements', 'announcements'];
    }

    match /quiz_results/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
    }

  }
}
